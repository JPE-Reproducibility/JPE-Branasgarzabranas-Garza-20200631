@article{Beckmann2009,
	abstract = {Introduction: Studies of resting-FMRI data increasingly often concern the estimation of differences between connectivity patterns, e.g. between different subject groups and/or between data sets obtained under different conditions such as pharmacological interventions. In this work we descibe an analysis approach which combines group-ICA with a dual regression approach in order to estimate such differences in functional connectivity. Methods: Initial data pre-processing involves correction for head motion, spatial and temporal filtering as well as co-registration of data to a common atlas space. The between subject analysis of the resting data then proceeds in three stages: Firstly, multiple FMRI data sets are concatenated temporally and ICA is applied in order to identify large-scale patterns of functional connectivity in the population (fig 1). Secondly, dual regression is used to identify, within each individual FMRI data set, corresponding temporal dynamics and associated spatial maps. This involves (A) using the group maps in a linear model fit, resulting in matrices describing temporal dynamics for each component and subject and (B) using these matrices in a linear model fit to estimate subject-specific spatial maps (fig 2). Finally, the different component maps are collected across subjects into single 4D files (one per original map) and analysed using parametric or non-parametric methods, e.g. GLM or permutation testing. This results in spatial maps characterising the between-subject/group differences (fig3). Results: The dual regression approach addresses a set of issues associated with alternative approaches for group resting-FMRI analysis. With respect to a seed-voxel based analysis approach the method promoted here does not rely on a single seed location but integrates the temporal information in the FMRI data across networks identified in the initial group ICA. The component maps of the initial ICA decomposition effectively define regions or networks of interest which are demonstrably relevant at the group level. Furthermore, this approach uses multiple linear regression instead of single regression and therefore can estimate significant differences in the presence of other sturctured effects in the data which otherwise might negatively impact such comparisons. With respect to alternative group-ICA methodology the approach presented here estimates spatial and temporal dynamics at the subject level based on regression against the original data rather than estimating subject-specific maps by means of 'back-projection' (see ref 4 for details). In the back- projection approach the estimated spatial maps necessarily lie within the space defined by the pseudo- inverse of the initial subject-specific major Eigenspaces (PCA) used for initial dimensionality-reduction. While this is computationally efficient, the final statistical comparison on the back-projected maps can become inaccurate as these maps can only represent the between-subject variation which falls within the initial PCA spaces. This is of particular importance as the effect differences can be small relative to the overall effect sizes. Conclusions: We have described an analysis approach which permits the identification of between- subject differences in resting functional connectivity based on between-subject similarities estimated within the framework of group-ICA. All the analysis steps can be carried out using tools from FSL. Further research using real and simulated data will allow for an assessment of the sensitivity and specificity of this technique.},
	author = {Beckmann and Mackay and Filippini and Smith},
	doi = {10.1073/pnas.0811879106},
	isbn = {1091-6490 (Electronic)$\backslash$n0027-8424 (Linking)},
	issn = {1091-6490},
	journal = {NeuroImage},
	mendeley-groups = {Value Based,All 3 papers},
	number = {Suppl 1},
	pages = {S148},
	pmid = {19357304},
	publisher = {Elsevier Inc.},
	title = {{Group comparison of resting-state FMRI data using multi-subject ICA and dual regression}},
	url = {http://linkinghub.elsevier.com/retrieve/pii/S1053811909715113},
	volume = {47},
	year = {2009},
	Bdsk-Url-1 = {http://linkinghub.elsevier.com/retrieve/pii/S1053811909715113},
	Bdsk-Url-2 = {http://dx.doi.org/10.1073/pnas.0811879106}}

